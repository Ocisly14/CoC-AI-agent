        "Noto Sans",
        "Arial",
        "sans-serif"
      ],
      "cjk": [
        "Noto Sans CJK SC",
        "Source Han Sans SC",
        "PingFang SC",
        "sans-serif"
      ]
    },
    "bodyPx": [
      16,
      18
