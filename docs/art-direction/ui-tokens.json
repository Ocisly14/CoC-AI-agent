{
  "version": "1.0",
  "status": "design-only; not imported by runtime",
  "colorSpace": "sRGB",
  "palette": {
    "bone": "#E7DDC8",
    "ink": "#24282B",
    "umber": "#8A7968",
    "ochre": "#B58A50",
    "rust": "#984F43",
    "mist": "#A8B3AE",
    "teal": "#496669",
    "olive": "#666D50",
    "violet": "#696373",
    "amber": "#D9AE70"
  },
  "semantic": {
    "paper": "bone",
    "text": "ink",
    "panel": "ink",
    "inverseText": "bone",
    "accent": "ochre",
    "danger": "#91473C",
    "focusOnDark": "amber",
    "focusOnLight": "teal",
    "secondaryText": "#58564F",
    "disabledText": "#62605A",
    "paperRule": "#AFA591"
  },
  "typography": {
    "heading": {
      "latin": [
        "Noto Serif",
        "Georgia",
        "serif"
      ],
      "cjk": [
        "Noto Serif CJK SC",
        "Source Han Serif SC",
        "Songti SC",
        "serif"
      ]
    },
    "body": {
